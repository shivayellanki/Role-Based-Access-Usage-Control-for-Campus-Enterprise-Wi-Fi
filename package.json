{
  "name": "rb-wifi",
  "version": "1.0.0",
  "description": "Role-Based Access & Usage Control for Campus/Enterprise Wi-Fi",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "generate-data": "cd backend && node scripts/generate-data.js",
    "build": "cd frontend && npm install && npm run build",
    "start": "cd backend && node server.js",
    "setup-db": "cd backend && node scripts/setup-db.js",
    "seed-users": "cd backend && node scripts/seed-users.js"
  },
  "keywords": [
    "wifi",
    "rbac",
    "access-control",
    "enterprise"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0"
  }
}